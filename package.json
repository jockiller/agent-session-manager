{
  "name": "agent-session-manager",
  "version": "0.3.0",
  "packageManager": "pnpm@10.27.0",
  "description": "Unified session manager & disk optimizer for AI coding agents (Claude Code, Cursor, Codex, OpenCode & more)",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
