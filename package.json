    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "codemirror": "^6.0.2",
    "echarts": "^6.1.0",
    "marked": "^18.2.1"
  },
  "devDependencies": {
    "@lucide/svelte": "^1.52.0",
    "@sveltejs/adapter-static": "^3.0.10",
